      { id: 24, name: "Tabist Tsukuba Sky Hotel (ที่พักยืนยัน 34G2+8J)", cat: "hotel", catName: "Hotel", lat: 36.07543, lng: 140.101449, dist: "1.1 กม. (เดิน 14 นาที)", img: `${base}/images/tabist_sky_hotel_booking_01_ext.jpg`, link: `${base}/knowledge/hotel#tabist-sky`, desc: "ที่พักยืนยันสำหรับทริปนี้ คุ้มค่า สะอาด มีลานจอดรถฟรี" },
      { id: 25, name: "Daiwa Roynet Hotel Tsukuba", cat: "hotel", catName: "Hotel", lat: 36.0838, lng: 140.1108, dist: "101 ม. (เดิน 1 นาที)", img: `${base}/images/daiwa_roynet_tsukuba_real.jpg`, link: `${base}/knowledge/hotel#daiwa`, desc: "ที่พักทำเลอันดับ 1 ติดสถานี Tsukuba Station Exit A5" },
      { id: 26, name: "จุดเช่าจักรยาน Kanto Railway Tsukuba Station", cat: "cycling", catName: "เช่าจักรยาน", lat: 36.0830, lng: 140.1110, dist: "หน้าสถานี Tsukuba Exit A5", img: `${base}/images/tsukuba_station.jpg`, link: `${base}/day1#part-bike`, desc: "จุดบริการเช่าจักรยาน 500 เยน/วัน เปิด 09:00 - 18:00 น." }
    ];

    const catColor = {
      science: "#0284c7",
      nature: "#16a34a",
      food: "#d97706",
      hotel: "#be123c",
      cycling: "#0d9488"
    };

    const map = L.map('map').setView([36.1000, 140.1150], 12);

    L.tileLayer('https://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
      maxZoom: 20,
      subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
      attribution: '&copy; <a href="https://www.google.com/maps" target="_blank" rel="noopener">Google Maps</a>'
    }).addTo(map);

    const markers = [];
    const spotListContainer = document.getElementById('spot-list');

    function createPin(color) {
      return L.divIcon({
        className: 'custom-pin',
        html: `<div style="background-color: ${color}; width: 22px; height: 22px; border-radius: 50%; border: 3px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3);"></div>`,
        iconSize: [22, 22],
        iconAnchor: [11, 11]
      });
    }

    spotsData.forEach((spot) => {
      const color = catColor[spot.cat] || '#0f172a';
      const marker = L.marker([spot.lat, spot.lng], { icon: createPin(color) }).addTo(map);

      const popupContent = `
        <div style="width: 200px; font-family: sans-serif;">
          <img src="${spot.img}" style="width: 100%; height: 100px; object-fit: cover; border-radius: 6px; margin-bottom: 6px;" alt="${spot.name}">
          <div style="font-weight: 700; font-size: 0.9rem; margin-bottom: 4px; color: #0f172a;">${spot.name}</div>
          <div style="font-size: 0.8rem; color: #64748b; margin-bottom: 8px;">${spot.desc}</div>
          <a href="${spot.link}" style="display: block; text-align: center; background: #0f172a; color: white; border-radius: 9999px; padding: 4px 8px; font-size: 0.75rem; text-decoration: none;">ดูรายละเอียด</a>
        </div>
      `;
      marker.bindPopup(popupContent);
      markers.push({ category: spot.cat, marker: marker, id: spot.id });

      const card = document.createElement('div');
      card.className = 'flex items-center gap-3 p-2 bg-white border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-50 hover:border-slate-300 transition-colors spot-item-card';
      card.setAttribute('data-cat', spot.cat);
      card.onclick = () => {
        map.setView([spot.lat, spot.lng], 14);
        marker.openPopup();
      };

      card.innerHTML = `
        <img src="${spot.img}" class="w-12 h-12 rounded-lg object-cover shrink-0" alt="${spot.name}">
        <div class="min-w-0 flex-1">
          <div class="font-bold text-slate-900 text-xs truncate">${spot.name}</div>
          <span class="inline-block px-1.5 py-0.5 bg-slate-100 text-slate-600 text-[10px] rounded mt-0.5 font-medium">${spot.dist}</span>
        </div>
      `;
      spotListContainer.appendChild(card);
    });

    const filterBtns = document.querySelectorAll('.filter-btn');
    filterBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        filterBtns.forEach(b => {
          b.classList.remove('active', 'bg-slate-900', 'text-white');
          b.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
        });
        this.classList.add('active', 'bg-slate-900', 'text-white');
        this.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');

        const cat = this.getAttribute('data-cat');

        markers.forEach(item => {
          if (cat === 'all' || item.category === cat) {
            map.addLayer(item.marker);
          } else {
            map.removeLayer(item.marker);
          }
        });

        document.querySelectorAll('.spot-item-card').forEach(card => {
          if (cat === 'all' || card.getAttribute('data-cat') === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        setTimeout(() => { map.invalidateSize(); }, 150);
      });
    });

    setTimeout(() => { map.invalidateSize(); }, 300);
    window.addEventListener('resize', () => { map.invalidateSize(); });
  });
</script>
