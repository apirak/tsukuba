---
import Layout from '../layouts/Layout.astro';
import DayMap, { type Spot } from '../components/DayMap.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const day0Spots: Spot[] = [
  {
    step: 1,
    name: "สนามบิน Narita / Haneda",
    lat: 35.7720,
    lng: 140.3929,
    desc: "จุดแลนดิ้ง ผ่าน ตม. และขึ้น Highway Bus",
    distFromPrev: "จุดเริ่มต้น",
    icon: "fa-plane-arrival",
    img: `${base}/images/narita_tsukuba_bus_real.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Narita+Airport"
  },
  {
    step: 2,
    name: "Tsukuba Center Bus Terminal",
    lat: 36.0830,
    lng: 140.1110,
    desc: "ปลายทางรถบัส ติดสถานีรถไฟ Tsukuba Express (Exit A5)",
    distFromPrev: "~55 กม. (บัส 55–60 นาที)",
    icon: "fa-bus",
    img: `${base}/images/tsukuba_center_building_real.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Tsukuba+Center+Bus+Terminal"
  },
  {
    step: 3,
    name: "Tabist Tsukuba Sky Hotel (34G2+8J)",
    lat: 36.07543,
    lng: 140.101449,
    desc: "ที่พักยืนยัน (พิกัด 34G2+8J) เช็กอิน พักผ่อนและฝากกระเป๋า",
    distFromPrev: "~1.1 กม. (เดิน 14 นาที / แท็กซี่ 4 นาที)",
    icon: "fa-hotel",
    img: `${base}/images/tabist_sky_hotel_booking_01_ext.jpg`,
    googleMapsUrl: "https://maps.app.goo.gl/Z5UDePpiZXo2gM1J7"
  },
  {
    step: 4,
    name: "BiVi Tsukuba / Tonarie (มื้อเย็น)",
    lat: 36.0831,
    lng: 140.1100,
    desc: "โซนร้านอาหารมื้อเย็น ทานราเมน/ซูชิ & เดินเล่นกลางคืน",
    distFromPrev: "~1.2 กม. (เดินย้อนกลับมาจากโรงแรม)",
    icon: "fa-utensils",
    img: `${base}/images/tsukuba_center_building.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=BiVi+Tsukuba"
  }
];
---

<Layout title="Day 0: ลงสนามบิน & เข้าที่พัก - Tsukuba Travel Strategy" activePath="/day0">
  <!-- Header -->
  <header class="bg-slate-900 text-white py-12 border-b border-slate-800 text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-sky-500/20 text-sky-300 border border-sky-500/30 rounded-full text-xs font-semibold">
        <i class="fa-solid fa-plane-arrival"></i> ARRIVAL & CHECK-IN
      </span>
      <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight">
        Day 0: สนามบิน &rarr; Highway Bus &rarr; สึกุบะ &rarr; เข้าที่พัก
      </h1>
      <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto">
        ระยะเวลาเดินทางรวม: ~60–90 นาที จากสนามบินนาริตะ/ฮาเนดะ ตรงถึงเมืองสึกุบะ
      </p>
    </div>
  </header>

  <div class="max-w-4xl mx-auto px-4 py-10 space-y-10">

    <!-- Day 0 Route Map (TOP SECTION) -->
    <DayMap 
      mapId="map-day0"
      title="แผนที่เส้นทาง Day 0: สนามบิน → ที่พัก"
      subtitle="แสดงจุดแวะและระยะทางระหว่างสนามบิน รถบัส Tsukuba Center และโรงแรมที่พัก"
      themeColor="sky"
      spots={day0Spots}
      totalDistance="ระยะทางรวม ~57 กม."
    />

    <!-- Summary Box -->
    <section class="bg-sky-50 border border-sky-200/80 rounded-2xl p-6 shadow-sm">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-xl bg-sky-600 text-white flex items-center justify-center text-xl shrink-0 shadow-sm">
          <i class="fa-solid fa-route"></i>
        </div>
        <div class="space-y-1">
          <h2 class="text-lg font-bold text-slate-900">สรุปการเดินทาง Day 0</h2>
          <p class="text-slate-700 text-sm leading-relaxed">
            ลงเครื่องบินผ่าน ตม. &rarr; ซื้อตั๋ว Highway Bus ตรงสู่ Tsukuba Center (ไม่ต้องเปลี่ยนขบวน) &rarr; 
            เช็กอินโรงแรม Tabist Tsukuba Sky Hotel &rarr; เดินเล่นชมเมือง/มื้อเย็นแถว Tsukuba Station
          </p>
        </div>
      </div>
    </section>

    <!-- Timeline Steps -->
    <div class="space-y-8 relative">

      <!-- Step 1 -->
      <article class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm space-y-4 relative pl-16 md:pl-20">
        <div class="absolute top-6 left-5 md:left-6 w-9 h-9 rounded-full bg-sky-600 text-white font-bold flex items-center justify-center text-sm shadow-sm">
          1
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="px-2.5 py-0.5 bg-sky-100 text-sky-800 font-semibold text-xs rounded-full">Step 1 • Airport Exit</span>
            <span class="text-xs text-slate-500 font-medium"><i class="fa-solid fa-plane-arrival me-1"></i> สนามบิน Narita / Haneda</span>
          </div>

          <h2 class="text-xl md:text-2xl font-bold text-slate-900">
            ผ่าน ตม. รับกระเป๋า & เดินออกประตูผู้โดยสารขาเข้า
          </h2>
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          เมื่อเครื่องบินแลนดิ้งที่สนามบินนาริตะ (NRT) หรือฮาเนดะ (HND) ให้เดินตามป้าย Arrivals ผ่านตรวจคนเข้าเมือง (ตม.) และรับกระเป๋าสัมภาระ แล้วเดินออกมาที่ Arrival Hall
        </p>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-5 space-y-3 text-sm text-slate-700">
          <h3 class="font-bold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-list-check text-sky-600"></i>ขั้นตอนปฏิบัติทีละสเต็ป:
          </h3>
          <ol class="list-decimal pl-5 space-y-1.5 marker:font-semibold marker:text-slate-600">
            <li>เตรียม <strong>Visit Japan Web QR Code</strong> (หรือกรอกใบ ตม. สีเหลืองบนเครื่อง)</li>
            <li>เดินผ่านช่องอัตโนมัติ/เจ้าหน้าที่ ตม. สแกนพาสปอร์ตและลายนิ้วมือ</li>
            <li>รับกระเป๋าที่สายพาน (Baggage Claim)</li>
            <li>เดินผ่านศุลกากร ยื่น QR Code หรือใบสำแดงศุลกากร</li>
            <li>เมื่อก้าวพ้นประตู Arrival Hall ให้มองหาป้ายสัญลักษณ์ <strong>"Bus / Highway Bus"</strong></li>
          </ol>
          
          <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-xs text-amber-900 mt-2">
            <i class="fa-solid fa-lightbulb me-1.5 text-amber-600"></i><strong>Tip มือใหม่:</strong> ที่สนามบินจะมีห้องน้ำสะอาด และตู้กดน้ำดื่มเปล่าฟรี แนะนำให้เข้าห้องน้ำให้เรียบร้อยก่อนขึ้นรถบัส
          </div>
        </div>
      </article>

      <!-- Step 2 -->
      <article class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm space-y-4 relative pl-16 md:pl-20">
        <div class="absolute top-6 left-5 md:left-6 w-9 h-9 rounded-full bg-sky-600 text-white font-bold flex items-center justify-center text-sm shadow-sm">
          2
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="px-2.5 py-0.5 bg-sky-100 text-sky-800 font-semibold text-xs rounded-full">Step 2 • Keisei Bus Counter</span>
            <span class="text-xs text-slate-500 font-medium"><i class="fa-solid fa-ticket me-1"></i> ค่าโดยสาร ~2,400 เยน</span>
          </div>

          <h2 class="text-xl md:text-2xl font-bold text-slate-900">
            ซื้อตั๋วรถ Highway Bus ตรงไป Tsukuba Center
          </h2>
        </div>

        <div class="rounded-xl overflow-hidden border border-slate-200 max-h-80">
          <img src={`${base}/images/narita_tsukuba_bus_real.jpg`} alt="Highway Bus Narita to Tsukuba" class="w-full h-64 object-cover" />
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          ซื้อตั๋วรถ Highway Bus (Keisei Bus / Kanto Railway) นั่งยาวตรงจากสนามบินนาริตะถึง Tsukuba Center 
          (ไม่ต้องต่อรถไฟ ไม่ต้องลากกระเป๋าเปลี่ยนขบวน) ใช้เวลาประมาณ 55–60 นาที
        </p>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-5 space-y-4 text-sm text-slate-700">
          <div class="space-y-2">
            <h3 class="font-bold text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-building text-sky-600"></i>วิธีซื้อตั๋วที่เคาน์เตอร์ Keisei Bus:
            </h3>
            <ul class="list-disc pl-5 space-y-1">
              <li>เดินไปที่เคาน์เตอร์ <strong>Keisei Bus Ticket Counter</strong> บริเวณ Arrival Hall</li>
              <li>ยื่นพาสปอร์ตหรือบอกพนักงาน: <em>"Tsukuba Center, 3 Persons"</em> (หรือโชว์ข้อความ: <strong>つくばセンター行き バス 3枚</strong>)</li>
              <li>พนักงานจะออกตั๋วพร้อมบอกเลขชานชาลา (Bus Stop Number) และรอบเวลา</li>
              <li>สามารถใช้เงินสด หรือบัตรเครดิต/Suica/IC Card จ่ายได้</li>
            </ul>
          </div>

          <div class="space-y-2">
            <h3 class="font-bold text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-bus text-emerald-600"></i>การขึ้นรถบัสที่ป้าย:
            </h3>
            <ul class="list-disc pl-5 space-y-1">
              <li>เดินไปที่ป้ายรถบัสตามหมายเลขในตั๋ว (เช่น NRT Terminal 1 ป้ายหมายเลข 8 / Terminal 2 ป้ายหมายเลข 8 หรือ 10)</li>
              <li>มีเจ้าหน้าที่ใส่ยูนิฟอร์มคอยยกลูกกระเป๋าเดินทางโหลดเก็บใต้ท้องรถบัสให้ พร้อมมอบป้ายแท็กสัมภาระ</li>
              <li>ขึ้นไปนั่งบนรถบัสตามหมายเลขที่นั่ง รถมีแอร์และเบาะนุ่มนั่งสบาย</li>
            </ul>
          </div>
        </div>
      </article>

      <!-- Step 3 -->
      <article class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm space-y-4 relative pl-16 md:pl-20">
        <div class="absolute top-6 left-5 md:left-6 w-9 h-9 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-sm shadow-sm">
          3
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 font-semibold text-xs rounded-full">Step 3 • Arrival & Bus Hub</span>
            <span class="text-xs text-slate-500 font-medium"><i class="fa-solid fa-location-dot me-1"></i> Tsukuba Center</span>
          </div>

          <h2 class="text-xl md:text-2xl font-bold text-slate-900">
            ถึงสถานี Tsukuba Center Bus Terminal (หน้าสถานีรถไฟ Exit A5)
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 my-2">
          <div class="rounded-xl overflow-hidden border border-slate-200 shadow-xs">
            <img src={`${base}/images/tsukuba_bus_station_matcha.webp`} alt="ป้ายรถบัสหน้าสถานี Tsukuba Center" class="w-full h-44 object-cover" />
            <div class="bg-slate-50 p-2 text-center font-medium text-xs text-slate-700">ป้ายรถบัสหน้าสถานี Tsukuba Station (TX)</div>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-200 shadow-xs">
            <img src={`${base}/images/tsukubasanguchi_bus_stop_matcha.webp`} alt="ป้ายรถบัส Tsukubasanguchi และ Numata" class="w-full h-44 object-cover" />
            <div class="bg-slate-50 p-2 text-center font-medium text-xs text-slate-700">จุดจอดรถบัสป้าย Numata / Tsukubasanguchi</div>
          </div>
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          รถบัสจากสนามบินจะมาจอดที่ Tsukuba Center Bus Terminal ซึ่งเป็นศูนย์กลางระบบขนส่งของเมืองสึกุบะ ติดกับสถานีรถไฟ Tsukuba Express (Exit A5) และห้างสรรพสินค้า Tonarie Tsukuba
        </p>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-5 space-y-4 text-sm text-slate-700">
          <ul class="list-disc pl-5 space-y-1.5">
            <li>เมื่อรถบัสจอดสนิท พนักงานจะยกกระเป๋าออกจากใต้ท้องรถ ยื่นแท็กสัมภาระเพื่อรับกระเป๋า</li>
            <li>ในบริเวณ Tsukuba Center มีตู้ล็อกเกอร์ฝากกระเป๋า (Coin Lockers), ร้านสะดวกซื้อ FamilyMart / Lawson, ร้านยา และตู้ ATM 7-Bank</li>
            <li>หากมาถึงช่วงมื้อเย็น/ค่ำ สามารถแวะทานอาหารที่ตึก BiVi Tsukuba หรือห้าง Tonarie ก่อนเข้าที่พักได้</li>
          </ul>

          <div class="bg-sky-50 border border-sky-200 rounded-xl p-4 space-y-2">
            <h3 class="font-bold text-slate-900 flex items-center gap-2 text-sm">
              <i class="fa-solid fa-bus text-sky-600"></i>การเดินทางด้วยรถบัสประจำทางสู่ Tsukubasanguchi (ประตูสู่เขาทสึคุบะ):
            </h3>
            <ul class="list-disc pl-5 space-y-1 text-xs leading-relaxed text-slate-700">
              <li><strong>จุดเริ่มต้น:</strong> ออกจากสถานี Tsukuba Station (TX) ขึ้นรถบัสที่ Bus Terminal ด้านหน้า</li>
              <li><strong>Tsukubasan Shuttle Bus:</strong> นั่ง ~30 นาที ลงป้าย <em>Numata (ぬまた)</em> แล้วเดินต่อ 3 นาทีถึง Tsukubasanguchi</li>
              <li><strong>รถประจำทางธรรมดา (Kantetsu Bus):</strong> นั่ง ~45 นาที รถจะจอดสุดสายที่ <em>Tsukubasanguchi</em> สะดวกไม่ต้องต่อเดิน</li>
            </ul>
          </div>

          <a href="https://maps.google.com/?q=Tsukuba+Center+Bus+Terminal" target="_blank" class="inline-flex items-center px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-full text-xs font-semibold border border-slate-300 transition-colors">
            <i class="fa-solid fa-map-location-dot me-1.5"></i>เปิดพิกัด Tsukuba Center บน Google Maps
          </a>
        </div>
      </article>

      <!-- Step 4 -->
      <article class="bg-white border-2 border-rose-300 rounded-2xl p-6 md:p-8 shadow-md space-y-4 relative pl-16 md:pl-20">
        <div class="absolute top-6 left-5 md:left-6 w-9 h-9 rounded-full bg-rose-600 text-white font-bold flex items-center justify-center text-sm shadow-sm">
          4
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="px-2.5 py-0.5 bg-rose-100 text-rose-800 font-semibold text-xs rounded-full">Step 4 • Hotel Check-in</span>
            <span class="text-xs text-rose-700 font-semibold"><i class="fa-solid fa-star me-1"></i> ที่พักยืนยัน</span>
          </div>

          <h2 class="text-xl md:text-2xl font-bold text-slate-900">
            เข้าเช็กอินที่พัก: Tabist Tsukuba Sky Hotel (Tabist つくばスカイホテル)
          </h2>
          
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-0.5 bg-sky-100 text-sky-800 font-medium text-xs rounded-full">7.1 / 10 Good (Booking.com 349 รีวิว)</span>
            <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 font-medium text-xs rounded-full">Value for Money 8.2 / 10 ⭐</span>
          </div>
        </div>

        <div class="rounded-xl overflow-hidden border border-slate-200 max-h-80">
          <img src={`${base}/images/tabist_sky_hotel_booking_01_ext.jpg`} alt="Tabist Tsukuba Sky Hotel Booking" class="w-full h-64 object-cover" />
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          โรงแรม Tabist Tsukuba Sky Hotel (3-Star Rating) ตั้งอยู่อำเภอโอโนซากิ (Onozaki) ห่างจากสถานี Tsukuba Station ประมาณ 1.2 กิโลเมตร 
          ทำเลเงียบสงบ ห้องพักสะอาด กว้างขวาง มีที่จอดรถฟรี และได้รับการประเมินความคุ้มค่าราคาสูงถึง 8.2/10 บน Booking.com
        </p>

        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-xs text-amber-900 space-y-2">
          <strong class="font-bold flex items-center gap-1.5 text-amber-950 text-sm">
            <i class="fa-solid fa-route"></i> วิธีเดินทางจาก Tsukuba Station ไปโรงแรม (เลือกตามสะดวก):
          </strong>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>วิธี A (นั่งแท็กซี่ - แนะนำถ้ามีกระเป๋าใหญ่):</strong> เดินไปจุดจอดแท็กซี่หน้า Exit A5 นั่งเพียง 4–5 นาที ค่าโดยสารประมาณ 700–900 เยน โชว์ชื่อโรงแรม: <em>Tabist つくばスカイホテル (つくば市小野崎283-1)</em></li>
            <li><strong>วิธี B (เดินเท้า 15 นาที):</strong> เดินตามทางเท้าลอยฟ้า Pedestrian Deck มุ่งหน้าทิศใต้ วิวสวยงาม อากาศเย็นสบาย</li>
          </ul>
        </div>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-5 space-y-3 text-sm text-slate-700">
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>ที่อยู่อย่างเป็นทางการ:</strong> 283-1 Onozaki, Tsukuba, Ibaraki 305-0034, Japan (〒305-0034 茨城県つくば市小野崎283-1 • Plus Code: 34G2+8J)</li>
            <li><strong>สิ่งอำนวยความสะดวก:</strong> Free Wi-Fi, แอร์/ฮีตเตอร์, ไดร์เป่าผม, อุปกรณ์อาบน้ำครบชุด, พื้นที่ไมโครเวฟ/กาต้มน้ำส่วนกลาง</li>
            <li><strong>ขั้นตอน Check-in:</strong> ยื่นพาสปอร์ตของทุกคนในคณะ รับคีย์การ์ดห้องพัก ชำระค่าที่พัก (หากยังไม่ได้ตัดบัตร)</li>
          </ul>

          <a href="https://maps.app.goo.gl/Z5UDePpiZXo2gM1J7" target="_blank" class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-full text-xs font-semibold transition-colors">
