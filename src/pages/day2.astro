---
import Layout from '../layouts/Layout.astro';
import DayMap, { type Spot } from '../components/DayMap.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const day2Spots: Spot[] = [
  {
    step: 1,
    name: "Tsukuba Expo Center",
    lat: 36.0858,
    lng: 140.1132,
    desc: "ท้องฟ้าจำลองโดมยักษ์ใหญ่ติดอันดับโลก & จรวด H-II 50 เมตร",
    distFromPrev: "จุดเริ่มต้น (เดิน 450 ม. จากสถานี)",
    icon: "fa-rocket",
    img: `${base}/images/tsukuba_expo_center.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Tsukuba+Expo+Center"
  },
  {
    step: 2,
    name: "Center Building & Tsukuba Art Museum",
    lat: 36.0825,
    lng: 140.1138,
    desc: "สถาปัตยกรรมระดับโลก Arata Isozaki Sunken Plaza & พิพิธภัณฑ์ศิลปะ",
    distFromPrev: "~300 ม. (เดิน 4 นาที)",
    icon: "fa-building-columns",
    img: `${base}/images/tsukuba_center_building_real.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Tsukuba+Center+Building"
  },
  {
    step: 3,
    name: "Sushi Dokoro Yagura Tsukuba Honten",
    lat: 36.0805,
    lng: 140.1175,
    desc: "มื้อเที่ยงซูชิดั้งเดิม ชิ้นใหญ่สดฉ่ำ นิกิริ & ข้าวหน้าปลาดิบรวม ชิราชิด้ง",
    distFromPrev: "~600 ม. (เดิน 8 นาที)",
    icon: "fa-fish",
    img: `${base}/images/sushi_yagura_real.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Sushi+Dokoro+Yagura+Tsukuba+Honten"
  },
  {
    step: 4,
    name: "สวนมัตสึมิ & หอชมวิว 45m (Matsumi Park)",
    lat: 36.0910,
    lng: 140.1076,
    desc: "ขึ้นหอชมวิวแปดเหลี่ยมสูง 45m ชมวิว 360° & สวนญี่ปุ่นบึงปลาคาร์ฟ (1 Chome-4 Amakubo • 34R5+93)",
    distFromPrev: "~1.5 กม. (เดิน 15 นาที / แท็กซี่ 4 นาที)",
    icon: "fa-tower-observation",
    img: `${base}/images/tsukubasan_shrine_real.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Matsumi+Park+Tsukuba"
  },
  {
    step: 5,
    name: "สถานี Tsukuba ➔ มุ่งหน้าสู่ลานสกี",
    lat: 36.0830,
    lng: 140.1110,
    desc: "รับกระเป๋าสัมภาระ ขึ้นรถไฟ TX กลับโตเกียว ต่อ Shinkansen ไปลานสกี",
    distFromPrev: "~1.2 กม. ย้อนกลับมาสถานี",
    icon: "fa-snowflake",
    img: `${base}/images/tsukuba_center_building_real.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Tsukuba+Station"
  }
];
---

<Layout title="Day 2: เที่ยวในเมือง & ซูชิขึ้นชื่อ & มุ่งหน้าสู่ลานสกี - Tsukuba Travel Strategy" activePath="/day2">
  <!-- Header -->
  <header class="bg-slate-900 text-white py-12 border-b border-slate-800 text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full text-xs font-semibold">
        <i class="fa-solid fa-building-columns"></i> INNER CITY & SKI PREP
      </span>
      <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight">
        Day 2: เที่ยวสถานที่ในเมือง &rarr; ซูชิพรีเมียม &rarr; ออกเดินทางไปลานสกี
      </h1>
      <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto">
        ชมท้องฟ้าจำลองยักษ์ Expo Center, เดิน Sunken Plaza, ลิ้มลองซูชิชิ้นใหญ่ร้านดัง Yagura และชมวิวสวนมัตสึมิ ก่อนมุ่งหน้าสู่ลานสกี
      </p>
    </div>
  </header>

  <div class="max-w-4xl mx-auto px-4 py-10 space-y-10">

    <!-- Day 2 Route Map (TOP SECTION) -->
    <DayMap 
      mapId="map-day2"
      title="แผนที่เส้นทาง Day 2: ท่องเที่ยวในเมือง & เดินทางสู่ลานสกี"
      subtitle="พิกัดจุดท่องเที่ยว Expo Center, Tsukuba Center Building, ร้านซูชิ Yagura Honten และหอชมวิวสวนมัตสึมิ"
      themeColor="amber"
      spots={day2Spots}
      totalDistance="ระยะทางเที่ยวในเมืองรวมเพียง ~3.5 กม. (เดินชิลล์ / แท็กซี่สะดวกสบาย)"
    />

    <!-- Summary Banner -->
    <section class="bg-amber-50/70 border border-amber-200 rounded-2xl p-6 md:p-8 space-y-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-amber-200/80 pb-4">
        <div>
          <span class="inline-block px-2.5 py-0.5 bg-amber-200/80 text-amber-900 font-semibold text-xs rounded-full">
            ภาพรวมแผนงาน Day 2 (ไม่ซ้ำกับ Day 0 และ Day 1)
          </span>
          <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">
            ตารางเวลา & ไฮไลต์โซนศูนย์กลางเมือง (Inner City Focus)
          </h2>
        </div>
        <span class="px-3 py-1 bg-sky-600 text-white font-semibold text-xs rounded-full">
          เดินชิลช้อปปิ้ง + ไปลานสกีต่อ ⛷️
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <a href="#part-expo" class="group bg-white border border-amber-100 hover:border-amber-400 rounded-xl p-4 transition-all shadow-xs hover:shadow-md space-y-1.5">
          <span class="inline-block px-2 py-0.5 bg-slate-100 text-slate-600 font-semibold text-[11px] rounded">09:30 – 11:30</span>
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-amber-700 transition-colors">
            <i class="fa-solid fa-rocket text-sky-600 me-1"></i> 1. Expo Center
          </h3>
          <p class="text-slate-500 text-xs leading-relaxed">โดมท้องฟ้าจำลองใหญ่ติดอันดับโลก & จรวด H-II 50 เมตร</p>
        </a>

        <a href="#part-plaza" class="group bg-white border border-amber-100 hover:border-amber-400 rounded-xl p-4 transition-all shadow-xs hover:shadow-md space-y-1.5">
          <span class="inline-block px-2 py-0.5 bg-slate-100 text-slate-600 font-semibold text-[11px] rounded">11:45 – 12:30</span>
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-amber-700 transition-colors">
            <i class="fa-solid fa-building-columns text-amber-600 me-1"></i> 2. Center Building & Art
          </h3>
          <p class="text-slate-500 text-xs leading-relaxed">สถาปัตยกรรมระดับโลก Arata Isozaki & พิพิธภัณฑ์ศิลปะ</p>
        </a>

        <a href="#part-sushi" class="group bg-white border border-amber-100 hover:border-amber-400 rounded-xl p-4 transition-all shadow-xs hover:shadow-md space-y-1.5">
          <span class="inline-block px-2 py-0.5 bg-slate-100 text-slate-600 font-semibold text-[11px] rounded">12:30 – 14:00</span>
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-amber-700 transition-colors">
            <i class="fa-solid fa-fish text-emerald-600 me-1"></i> 3. ร้านซูชิ Yagura Honten
          </h3>
          <p class="text-slate-500 text-xs leading-relaxed">ซูชิสดชิ้นใหญ่พรีเมียม & ข้าวหน้าปลาดิบชิราชิด้ง</p>
        </a>

        <a href="#part-matsumi" class="group bg-white border border-amber-100 hover:border-amber-400 rounded-xl p-4 transition-all shadow-xs hover:shadow-md space-y-1.5">
          <span class="inline-block px-2 py-0.5 bg-slate-100 text-slate-600 font-semibold text-[11px] rounded">14:15 – 15:30</span>
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-amber-700 transition-colors">
            <i class="fa-solid fa-tower-observation text-teal-600 me-1"></i> 4. สวนมัตสึมิ (Matsumi Park)
          </h3>
          <p class="text-slate-500 text-xs leading-relaxed">หอชมวิวสูง 45m ชมวิว 360° & สวนญี่ปุ่นปลาคาร์ฟ</p>
        </a>
      </div>
    </section>

    <!-- Detail Breakdown -->
    <div class="space-y-8">
      <div class="space-y-1 border-b border-slate-200 pb-4">
        <span class="inline-block px-3 py-1 bg-sky-100 text-sky-800 font-semibold text-xs rounded-full">
          Detailed Breakdown
        </span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">
          รายละเอียดแผนการเดินทาง Day 2
        </h2>
        <p class="text-slate-600 text-sm">
          ข้อมูลสถานที่ การเดินทาง ค่าใช้จ่าย และคำแนะนำสำหรับการเดินทางต่อ
        </p>
      </div>

      <!-- Step 1: Tsukuba Expo Center -->
      <article id="part-expo" class="bg-white border-2 border-amber-300 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-amber-600 text-white font-bold flex items-center justify-center text-sm shadow-sm shrink-0">1</span>
            <div>
              <span class="px-2.5 py-0.5 bg-amber-100 text-amber-800 font-semibold text-xs rounded-full">09:30 – 11:30 (เดิน 5 นาทีจากสถานี/โรงแรม)</span>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">Tsukuba Expo Center (ศูนย์วิทยาศาสตร์เอ็กซ์โปสึกุบะ)</h2>
            </div>
          </div>
          <span class="px-3 py-1 bg-sky-600 text-white font-semibold text-xs rounded-full">ท้องฟ้าจำลองใหญ่ที่สุด</span>
        </div>

        <div class="rounded-xl overflow-hidden border border-slate-200 max-h-80">
          <img src={`${base}/images/tsukuba_expo_center.jpg`} alt="Tsukuba Expo Center Rocket" class="w-full h-64 object-cover" />
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          อนุสรณ์งานโลก Expo 1985 มีโดมท้องฟ้าจำลอง (Planetarium) เส้นผ่าศูนย์กลาง 25 เมตรใหญ่ติดอันดับโลก จรวด H-II โมเดล 50 เมตร 
          และห้องทดลองวิทยาศาสตร์ฟิสิกส์หุ่นยนต์แบบ Interactive ให้เด็กๆ ได้ทดลองจริง
        </p>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-5 space-y-3 text-sm text-slate-700">
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>ค่าเข้าชม:</strong> ผู้ใหญ่ 500 เยน / เด็ก 250 เยน (รวมตั๋วชมท้องฟ้าจำลอง ผู้ใหญ่ 1,000 เยน / เด็ก 500 เยน)</li>
            <li><strong>กิจกรรมเด่น:</strong> ดิ่งพสุธาจำลอง, ทดลองพลังงานลม, การแสดงไซเอนซ์โชว์การแช่แข็งด้วยไนโตรเจนเหลว</li>
          </ul>

          <a href="https://maps.google.com/?q=Tsukuba+Expo+Center" target="_blank" class="inline-flex items-center px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-full text-xs font-semibold border border-slate-300 transition-colors">
            <i class="fa-solid fa-map-location-dot me-1.5"></i>พิกัด Expo Center บน Google Maps
          </a>
        </div>
      </article>

      <!-- Step 2: Center Building & Art Museum -->
      <article id="part-plaza" class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-amber-600 text-white font-bold flex items-center justify-center text-sm shadow-sm shrink-0">2</span>
            <div>
              <span class="px-2.5 py-0.5 bg-amber-100 text-amber-800 font-semibold text-xs rounded-full">11:45 – 12:30 (เดิน 3 นาที)</span>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">Tsukuba Center Building & Tsukuba Museum of Art</h2>
            </div>
          </div>
          <span class="px-3 py-1 bg-amber-600 text-white font-semibold text-xs rounded-full">สถาปัตยกรรมระดับโลก</span>
        </div>

        <div class="rounded-xl overflow-hidden border border-slate-200 max-h-80">
          <img src={`${base}/images/tsukuba_center_building_real.jpg`} alt="Tsukuba Center Building" class="w-full h-64 object-cover" />
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          ชมผลงานสถาปัตยกรรมระดับมาสเตอร์พีซของ Arata Isozaki (ผู้ได้รับรางวัล Pritzker Prize) ลาน Sunken Plaza รูปทรงเรขาคณิตยุค Postmodern และพิพิธภัณฑ์ศิลปะประจำจังหวัดอิบารากิ
        </p>
      </article>

      <!-- Step 3: Sushi Lunch at Sushi Dokoro Yagura Tsukuba Honten -->
      <article id="part-sushi" class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-sm shadow-sm shrink-0">3</span>
            <div>
              <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 font-semibold text-xs rounded-full">12:30 – 14:00 (ร้านซูชิดัง Yagura • ย่าน Takezono)</span>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">มื้อเที่ยงไฮไลต์: ร้านซูชิชิ้นใหญ่ Sushi Dokoro Yagura (鮨処 やぐら)</h2>
            </div>
          </div>
          <span class="px-3 py-1 bg-emerald-600 text-white font-semibold text-xs rounded-full">มื้อพิเศษประจำทริป 🍣</span>
        </div>

        <div class="rounded-xl overflow-hidden border border-slate-200 max-h-80">
          <img src={`${base}/images/sushi_yagura_real.jpg`} alt="Sushi Dokoro Yagura Tsukuba Honten" class="w-full h-64 object-cover" />
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          ทานมื้อเที่ยงซูชิดั้งเดิมระดับท็อปของเมืองทซึคุบะที่ร้าน <strong>Sushi Dokoro Yagura (鮨処 やぐら つくば本店)</strong> การันตีความอร่อยโดย Google 4.3 ⭐ (556 รีวิว) และ Wanderlog 
          เนื้อปลาสดชิ้นหนาใหญ่เต็มคำ ทั้งเซ็ต <strong>Nigiri (นิกิริ)</strong> หอยเชลล์ อูนิ ทูน่า และ <strong>Chirashi Don (ชิราชิด้ง)</strong> ข้าวหน้าปลาดิบรวมทรงเครื่องจุใจ
        </p>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-5 space-y-3 text-sm text-slate-700">
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>การเดินทาง:</strong> เดินเพียง 8 นาที (600 เมตร) จาก Tsukuba Station ทางออก A4 สู่ย่าน Takezono 1-8-8</li>
            <li><strong>เมนูแนะนำ:</strong> เซ็ต Nigiri Matsu/Take, ข้าวหน้าปลาดิบรวม Chirashi Don, และซุปมิโซะกุ้งร้อนๆ</li>
          </ul>

          <a href="https://maps.google.com/?q=Sushi+Dokoro+Yagura+Tsukuba+Honten" target="_blank" class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-full text-xs font-semibold transition-colors">
            <i class="fa-solid fa-map-location-dot me-1.5"></i>เปิด Google Maps
          </a>
        </div>
      </article>

      <!-- Step 4: Matsumi Park & Tower -->
      <article id="part-matsumi" class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-teal-600 text-white font-bold flex items-center justify-center text-sm shadow-sm shrink-0">4</span>
            <div>
              <span class="px-2.5 py-0.5 bg-teal-100 text-teal-800 font-semibold text-xs rounded-full">14:15 – 15:30 (ห่างสถานี 1.2 กม.)</span>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">สวนสาธารณะมัตสึมิ (Matsumi Park & 45m Observation Tower)</h2>
            </div>
          </div>
          <span class="px-3 py-1 bg-teal-600 text-white font-semibold text-xs rounded-full">หอชมวิวพาโนรามา</span>
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          สวนสาธารณะบรรยากาศสวนญี่ปุ่นสวยงาม มีหอชมวิวแปดเหลี่ยมสีแดงสูง 45 เมตร (Matsumi Observation Tower) ขึ้นไปชมวิวทิวทัศน์เมืองสึกุบะและเขาสึกุบะแบบ 360 องศา พร้อมบึงน้ำให้อาหารปลาคาร์ฟ
        </p>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-5 space-y-3 text-sm text-slate-700">
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>ที่อยู่อย่างเป็นทางการ:</strong> 1 Chome-4 Amakubo, Tsukuba, Ibaraki 305-0005, Japan (Plus Code: 34R5+93 Tsukuba, Ibaraki)</li>
            <li><strong>ค่าขึ้นหอชมวิว:</strong> ผู้ใหญ่ 100 เยน / เด็ก 50 เยน (ถูกมากๆ วิวสวยงาม)</li>
            <li><strong>การเดินทางกลับสถานี:</strong> เดินกลับ 14 นาที หรือนั่งแท็กซี่ 3 นาที (~600 เยน) กลับมายัง Tsukuba Station</li>
          </ul>

          <a href="https://maps.google.com/?q=Matsumi+Park+Tsukuba" target="_blank" class="inline-flex items-center px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-full text-xs font-semibold border border-slate-300 transition-colors">
            <i class="fa-solid fa-map-location-dot me-1.5"></i>พิกัด Matsumi Park บน Google Maps
          </a>
        </div>
      </article>

      <!-- Step 5: Checkout & Departure to Ski Resort -->
      <article id="part-ski" class="bg-white border-2 border-teal-300 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-teal-600 text-white font-bold flex items-center justify-center text-sm shadow-sm shrink-0">5</span>
            <div>
              <span class="px-2.5 py-0.5 bg-teal-100 text-teal-800 font-semibold text-xs rounded-full">15:30 เป็นต้นไป</span>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">เช็กเอาต์รับกระเป๋า & ออกเดินทางมุ่งหน้าสู่ลานสกี (Ski Resort Transfer)</h2>
            </div>
          </div>
