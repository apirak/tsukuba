---
import Layout from '../layouts/Layout.astro';
import DayMap, { type Spot } from '../components/DayMap.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const day1Spots: Spot[] = [
  {
    step: 1,
    name: "จุดเช่าจักรยาน Kanto Railway Tsukuba",
    lat: 36.0830,
    lng: 140.1110,
    desc: "รับจักรยาน Helmet และแผนที่ หน้าสถานี Tsukuba Exit A5 (500 เยน/วัน)",
    distFromPrev: "จุดเริ่มต้น (สถานี Tsukuba)",
    icon: "fa-bicycle",
    img: `${base}/images/tsukuba_station.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Tsukuba+Station"
  },
  {
    step: 2,
    name: "JAXA Tsukuba Space Center",
    lat: 36.0645,
    lng: 140.1265,
    desc: "ชมจรวด H-II Rocket ยาว 50 เมตร & โดมจัดแสดงอวกาศ Space Dome",
    distFromPrev: "~2.1 กม. (ปั่น 8–10 นาที)",
    icon: "fa-shuttle-space",
    img: `${base}/images/jaxa_tsukuba_space_center_ta1.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=JAXA+Tsukuba+Space+Center"
  },
  {
    step: 3,
    name: "Science Square AIST & Geology Museum",
    lat: 36.0562,
    lng: 140.1365,
    desc: "หุ่นยนต์แมวน้ำ AI Paro, พิพิธภัณฑ์ธรณีวิทยา อัญมณีและฟอสซิล",
    distFromPrev: "~1.2 กม. (ปั่น 5 นาทีจาก JAXA)",
    icon: "fa-robot",
    img: `${base}/images/science_square_ta1.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Science+Square+AIST"
  },
  {
    step: 4,
    name: "มื้อเที่ยง: เบเกอรี่ Boulangerie Couronne Tsukuba",
    lat: 36.0612,
    lng: 140.1147,
    desc: "มื้อเที่ยงไฮไลต์! ร้านเบเกอรี่อันดับ 1 ของเมือง Tsukuba ขนมปังไส้กรอกยาว Long Sausage France & เทอร์เรซร่มรื่น",
    distFromPrev: "~1.5 กม. (ปั่น 5 นาทีจาก AIST/JAXA)",
    icon: "fa-wheat-awn",
    img: `${base}/images/couronne_tsukuba_real.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Couronne+Tsukuba"
  },
  {
    step: 5,
    name: "สวนสาธารณะโดโฮ & คืนจักรยาน",
    lat: 36.0602,
    lng: 140.1215,
    desc: "เดินชิลริมทะเลสาบสวน Doho Park ปั่นย้อนกลับคืนจักรยานก่อน 18:00 น. (เดินจากร้าน Couronne เพียง 2 นาที)",
    distFromPrev: "~200 ม. (เดินจากร้าน Couronne เข้าสวนโดโฮ)",
    icon: "fa-flag-checkered",
    img: `${base}/images/doho_park_scenery_real.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Doho+Park"
  },
  {
    step: 6,
    name: "มื้อเย็น: สเต๊กเนื้อวากิว Hitachi Beef Sansui",
    lat: 36.0825,
    lng: 140.1130,
    desc: "มื้อเย็นพรีเมียม สเต๊กเนื้อวัวฮิตาจิเกรด A5 ชั้น 2 Hotel Nikko Tsukuba (เดิน 2 นาทีจาก Exit A3)",
    distFromPrev: "ติดสถานี Tsukuba Station",
    icon: "fa-drumstick-bite",
    img: `${base}/images/hotel_nikko_tsukuba_real.jpg`,
    googleMapsUrl: "https://maps.google.com/?q=Hotel+Nikko+Tsukuba+Sansui"
  }
];
---

<Layout title="Day 1: ปั่นจักรยานชิลๆ โซน JAXA & ร้านเบเกอรี่ Couronne - Tsukuba Travel Strategy" activePath="/day1">
  <!-- Header -->
  <header class="bg-slate-900 text-white py-12 border-b border-slate-800 text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full text-xs font-semibold">
        <i class="fa-solid fa-bicycle"></i> JAXA & COURONNE BAKERY (EASY CYCLING)
      </span>
      <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight">
        Day 1: เช่าจักรยานปั่นชิลๆ ตะลุย JAXA & ลิ้มลองเบเกอรี่อันดับ 1 Couronne
      </h1>
      <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto">
        เน้นเที่ยวโซน JAXA, พิพิธภัณฑ์วิทยาศาสตร์ Science Square, มื้อเที่ยงเบเกอรี่อบสด Couronne และมื้อเย็นเทโชกุ Gohan-ya Fugen
      </p>
    </div>
  </header>

  <div class="max-w-4xl mx-auto px-4 py-10 space-y-10">

    <!-- Day 1 Route Map (TOP SECTION) -->
    <DayMap 
      mapId="map-day1"
      title="แผนที่เส้นทางปั่นจักรยาน Day 1 (JAXA & ร้านเบเกอรี่ Couronne)"
      subtitle="พิกัดจุดเช่าจักรยาน JAXA Space Center, Science Square AIST, ร้านเบเกอรี่ Couronne และสวน Doho Park"
      themeColor="emerald"
      spots={day1Spots}
      totalDistance="ระยะทางปั่นรวมทั้งวันเพียง ~6 กม. (วนเป็นวงกลมต่อเนื่อง ปั่นง่ายสบายๆ)"
    />

    <!-- TOP SECTION: Day 1 High-Level Plan Summary -->
    <section class="bg-emerald-50/70 border border-emerald-200 rounded-2xl p-6 md:p-8 space-y-6 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-emerald-200/80 pb-4">
        <div>
          <span class="inline-block px-2.5 py-0.5 bg-emerald-200/80 text-emerald-900 font-semibold text-xs rounded-full">
            ภาพรวมแผนงาน Day 1 (ระยะใกล้สบายๆ)
          </span>
          <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">
            ตารางเวลา & ไฮไลต์โซน JAXA & ร้าน Couronne (Top Summary)
          </h2>
        </div>
        <span class="px-3 py-1 bg-slate-900 text-white font-semibold text-xs rounded-full">
          จักรยาน 500 เยน / วัน
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <a href="#part-bike" class="group bg-white border border-emerald-100 hover:border-emerald-400 rounded-xl p-4 transition-all shadow-xs hover:shadow-md space-y-1.5">
          <span class="inline-block px-2 py-0.5 bg-slate-100 text-slate-600 font-semibold text-[11px] rounded">09:00 – 09:30</span>
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-emerald-700 transition-colors">
            <i class="fa-solid fa-bicycle text-emerald-600 me-1"></i> 1. เช่าจักรยาน
          </h3>
          <p class="text-slate-500 text-xs leading-relaxed">Kanto Railway Rent-a-cycle หน้าสถานี Tsukuba</p>
        </a>

        <a href="#part-jaxa" class="group bg-white border border-emerald-100 hover:border-emerald-400 rounded-xl p-4 transition-all shadow-xs hover:shadow-md space-y-1.5">
          <span class="inline-block px-2 py-0.5 bg-slate-100 text-slate-600 font-semibold text-[11px] rounded">09:45 – 11:45</span>
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-emerald-700 transition-colors">
            <i class="fa-solid fa-shuttle-space text-sky-600 me-1"></i> 2. JAXA Space Center
          </h3>
          <p class="text-slate-500 text-xs leading-relaxed">ชมจรวด H-II Rocket ยาว 50 เมตร & Space Dome</p>
        </a>

        <a href="#part-couronne" class="group bg-white border border-emerald-100 hover:border-emerald-400 rounded-xl p-4 transition-all shadow-xs hover:shadow-md space-y-1.5">
          <span class="inline-block px-2 py-0.5 bg-slate-100 text-slate-600 font-semibold text-[11px] rounded">12:30 – 14:00</span>
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-emerald-700 transition-colors">
            <i class="fa-solid fa-wheat-awn text-amber-600 me-1"></i> 3. มื้อเที่ยง: Couronne Tsukuba
          </h3>
          <p class="text-slate-500 text-xs leading-relaxed">ร้านเบเกอรี่อันดับ 1 ไส้กรอกยาว Long Sausage France</p>
        </a>

        <a href="#part-sansui" class="group bg-white border border-emerald-100 hover:border-emerald-400 rounded-xl p-4 transition-all shadow-xs hover:shadow-md space-y-1.5">
          <span class="inline-block px-2 py-0.5 bg-slate-100 text-slate-600 font-semibold text-[11px] rounded">18:00 – 19:30</span>
          <h3 class="font-bold text-slate-900 text-sm group-hover:text-emerald-700 transition-colors">
            <i class="fa-solid fa-drumstick-bite text-rose-600 me-1"></i> 4. มื้อเย็น: Hitachi Beef Sansui
          </h3>
          <p class="text-slate-500 text-xs leading-relaxed">สเต๊กเนื้อวัวฮิตาจิ A5 ชั้น 2 Hotel Nikko Tsukuba</p>
        </a>
      </div>

      <div class="bg-amber-50 border border-amber-200/80 rounded-xl p-3.5 text-xs text-amber-900">
        <i class="fa-solid fa-lightbulb me-1.5 text-amber-600"></i><strong>คำแนะนำเรื่องระยะทาง:</strong> เส้นทางนี้ออกแบบให้ปั่นระยะสั้น แต่ละจุดห่างกันเพียง 800 เมตร ถึง 2.1 กิโลเมตร บนทางเท้าลอยฟ้า Pedestrian Deck ไร้รถยนต์ ปั่นสบาย ปลอดภัยสำหรับครอบครัว 100%
      </div>
    </section>

    <!-- BOTTOM SECTION: Detailed Breakdown of Each Part -->
    <div class="space-y-8">
      <div class="space-y-1 border-b border-slate-200 pb-4">
        <span class="inline-block px-3 py-1 bg-sky-100 text-sky-800 font-semibold text-xs rounded-full">
          Detailed Breakdown
        </span>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">
          รายละเอียดเชิงลึกของแต่ละส่วน (Step-by-Step Details)
        </h2>
        <p class="text-slate-600 text-sm">
          คู่มือวิธีปฏิบัติ การเข้าชม ค่าใช้จ่าย และพิกัดสถานที่แต่ละจุด
        </p>
      </div>

      <!-- Part 1: Bike Rental -->
      <article id="part-bike" class="bg-white border-2 border-emerald-300 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-sm shadow-sm shrink-0">1</span>
            <div>
              <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 font-semibold text-xs rounded-full">09:00 – 09:30</span>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">จุดเช่าจักรยาน Kanto Railway Rent-a-cycle (สถานี Tsukuba)</h2>
            </div>
          </div>
          <span class="px-3 py-1 bg-slate-900 text-white font-semibold text-xs rounded-full">500 เยน / วัน</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 my-4">
          <div class="rounded-xl overflow-hidden border border-slate-200 shadow-xs">
            <img src={`${base}/images/tsukuba_station.jpg`} alt="จุดเช่าจักรยานสถานี Tsukuba Exit A5" class="w-full h-40 object-cover" />
            <div class="bg-slate-50 p-2 text-center font-medium text-xs text-slate-700">จุดบริการเช่าจักรยาน Exit A5</div>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-200 shadow-xs">
            <img src={`${base}/images/ringring_square_tsuchiura_shop.jpg`} alt="ร้านจำหน่ายและให้เช่าจักรยาน" class="w-full h-40 object-cover" />
            <div class="bg-slate-50 p-2 text-center font-medium text-xs text-slate-700">บริการจักรยานพร้อมหมวกกันน็อก</div>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-200 shadow-xs">
            <img src={`${base}/images/ringring_square_tsuchiura_bikes.jpg`} alt="จักรยานสภาพดีเยี่ยม ปั่นสบาย" class="w-full h-40 object-cover" />
            <div class="bg-slate-50 p-2 text-center font-medium text-xs text-slate-700">จักรยานแม่บ้าน & E-Bike ให้เช่า</div>
          </div>
        </div>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-5 space-y-4 text-sm text-slate-700">
          <div class="space-y-2">
            <h3 class="font-bold text-slate-900 flex items-center gap-2">
              <i class="fa-solid fa-file-signature text-emerald-600"></i>ขั้นตอนการเช่า (สถานี Tsukuba):
            </h3>
            <ol class="list-decimal pl-5 space-y-1">
              <li>ยื่นพาสปอร์ตเล่มจริงแก่เจ้าหน้าที่</li>
              <li>กรอกแบบฟอร์มชื่อภาษาอังกฤษ และเบอร์โทรศัพท์</li>
              <li>ชำระเงิน 500 เยน/คัน</li>
              <li>รับกุญแจ ล็อกจักรยาน และหมวกกันน็อก</li>
            </ol>
          </div>
        </div>
      </article>

      <!-- Part 2: JAXA Space Center -->
      <article id="part-jaxa" class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-sky-600 text-white font-bold flex items-center justify-center text-sm shadow-sm shrink-0">2</span>
            <div>
              <span class="px-2.5 py-0.5 bg-sky-100 text-sky-800 font-semibold text-xs rounded-full">09:45 – 11:45 (ปั่นจากสถานี ~2.1 กม.)</span>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">JAXA Tsukuba Space Center (ศูนย์อวกาศสึกุบะ)</h2>
            </div>
          </div>
          <span class="px-3 py-1 bg-sky-600 text-white font-semibold text-xs rounded-full">เข้าชมฟรี ⭐</span>
        </div>

        <div class="rounded-xl overflow-hidden border border-slate-200 max-h-80">
          <img src={`${base}/images/jaxa_tsukuba_space_center_ta1.jpg`} alt="JAXA Tsukuba Space Center H-II Rocket" class="w-full h-64 object-cover" />
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          ศูนย์วิจัยอวกาศหลักของญี่ปุ่น ชมจรวด H-II Rocket ขนาดจริงยาว 50 เมตรตั้งตระหง่านหน้าทางเข้า เข้าชมอาคารนิทรรศการ Space Dome ฟรี มอดูลห้องทดลองอวกาศ Kibo
        </p>
      </article>

      <!-- Part 3: Couronne Bakery Lunch -->
      <article id="part-couronne" class="bg-white border-2 border-amber-300 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-amber-600 text-white font-bold flex items-center justify-center text-sm shadow-sm shrink-0">3</span>
            <div>
              <span class="px-2.5 py-0.5 bg-amber-100 text-amber-800 font-semibold text-xs rounded-full">12:30 – 14:00 (ร้าน Boulangerie Couronne Tsukuba)</span>
              <h2 class="text-xl md:text-2xl font-bold text-slate-900 mt-1">มื้อเที่ยงไฮไลต์: ร้านเบเกอรี่อันดับ 1 Boulangerie Couronne (パン工房 クーロンヌ)</h2>
            </div>
          </div>
          <span class="px-3 py-1 bg-amber-600 text-white font-semibold text-xs rounded-full">เบเกอรี่ในตำนาน 🥖</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 my-2">
          <div class="rounded-xl overflow-hidden border border-slate-200">
            <img src={`${base}/images/couronne_tsukuba_real.jpg`} alt="หน้าร้านเรือนไม้และเบเกอรี่อบสดใหม่ร้าน Boulangerie Couronne Tsukuba" class="w-full h-56 object-cover" />
            <div class="bg-slate-50 p-2 text-center text-xs font-medium text-slate-700">หน้าร้านเรือนไม้ & เทอร์เรซกลางแจ้ง</div>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-200">
            <img src={`${base}/images/couronne_tsukuba.jpeg`} alt="บรรยากาศภายในร้านเบเกอรี่ Boulangerie Couronne Tsukuba ขนมปังอบสดใหม่จากเตาอบหิน" class="w-full h-56 object-cover" />
            <div class="bg-slate-50 p-2 text-center text-xs font-medium text-slate-700">ภายในร้าน เตาอบหินโบราณ (石窯焼) & ขนมปังสด</div>
          </div>
        </div>

        <p class="text-slate-600 text-sm leading-relaxed">
          ทานมื้อเที่ยงชิลๆ กับร้านเบเกอรี่อบสดใหม่ขึ้นชื่ออันดับ 1 ของเมือง Tsukuba <strong>Boulangerie Couronne (パン工房 クーロンヌ)</strong> ตั้งอยู่ริมสวน Doho Park โดดเด่นด้วยขนมปังฝรั่งเศสไส้กรอกยาวเกือบครึ่งเมตร Long Sausage France, ครีมปังไข่ Nasu นุ่มละมุน นั่งทานที่โต๊ะเทอร์เรซกลางแจ้งร่มรื่น หรือซื้อถือไปนั่งปิกนิกริมทะเลสาบในสวน Doho Park
        </p>

        <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-5 space-y-3 text-sm text-slate-700">
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>ที่ตั้ง:</strong> 〒305-0056 茨城県つくば市松野木152-40 (ขอบสวน Doho Park)</li>
            <li><strong>เมนูแนะนำ:</strong> Long Sausage France, Kiwami Cream Pan, ขนมปังแกงกะหรี่ และกาแฟ/ชาสด</li>
            <li><strong>การเดินทาง:</strong> เดินเพียง 2 นาทีจากสวน Doho Park หรือปั่นจักรยาน 5 นาทีจาก JAXA/AIST</li>
          </ul>

          <a href="https://maps.google.com/?q=Couronne+Tsukuba" target="_blank" class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-full text-xs font-semibold transition-colors">
            <i class="fa-solid fa-map-location-dot me-1.5"></i>เปิด Google Maps
          </a>
        </div>

        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-xs text-emerald-900 space-y-1">
          <p><i class="fa-solid fa-lightbulb me-1.5 text-emerald-600"></i><strong>ทางเลือกมื้อเที่ยงสำรอง (Alternative Choice):</strong></p>
          <p class="text-emerald-800 leading-relaxed">
            หากต้องการเปลี่ยนบรรยากาศเป็นคาเฟ่อาหารตึกปูนเปลือยมินิมอล Quiche Plate & กาแฟดริป สามารถแวะร้าน <strong>cox (コックス)</strong> ซึ่งตั้งอยู่ฝั่งตรงข้ามย่านเดียวกันได้เลย (ดูรายละเอียดเพิ่มเติมใน <a href={`${base}/knowledge/food#cafe-cox`} class="text-emerald-700 font-bold underline">Knowledge Hub: Cafe Cox</a>)
          </p>
        </div>
      </article>

      <!-- Part 4: Hitachi Beef Sansui Dinner -->
      <article id="part-sansui" class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-rose-600 text-white font-bold flex items-center justify-center text-sm shadow-sm shrink-0">4</span>
            <div>
