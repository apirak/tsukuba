---
interface Props {
  activePath?: string;
}

const { activePath = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const navItems = [
  { href: `${base}/`, label: "หน้าหลัก Portal", icon: "fa-solid fa-house" },
  { href: `${base}/day0`, label: "Day 0 (มาถึง & ที่พัก)", icon: "fa-solid fa-plane-arrival" },
  { href: `${base}/day1`, label: "Day 1 (ปั่นจักรยานไกล)", icon: "fa-solid fa-bicycle" },
  { href: `${base}/day2`, label: "Day 2 (เที่ยวเมือง & สกี)", icon: "fa-solid fa-building-columns" },
  { href: `${base}/knowledge`, label: "Knowledge Hub", icon: "fa-solid fa-book-open" },
];
---

<header class="sticky top-0 z-50 bg-black border-b border-slate-800 shadow-md">
  <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <a href={`${base}/`} class="flex items-center gap-2.5 text-white font-bold text-lg tracking-tight hover:opacity-90 transition-opacity">
      <i class="fa-solid fa-compass text-blue-500 text-xl"></i>
      <span>Tsukuba Travel Strategy</span>
    </a>

    <nav class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto pb-1 md:pb-0 scrollbar-none">
      {navItems.map(item => {
        const itemRoute = item.href.replace(base, "") || "/";
        const isActive = activePath === itemRoute || (itemRoute !== "/" && activePath.startsWith(itemRoute));
        return (
          <a
            href={item.href}
            class={`inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors ${
              isActive
                ? "bg-blue-600 text-white font-semibold shadow-sm"
                : "text-slate-400 hover:text-white hover:bg-white/10"
            }`}
          >
            <i class={`${item.icon} text-xs`}></i>
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>
  </div>
</header>
