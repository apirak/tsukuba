---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const {
  title = "Tsukuba Travel Strategy & Portal",
  description = "คู่มือและแผนเดินทางเที่ยวเมืองวิทยาศาสตร์สึกุบะ 3 วันสำหรับครอบครัว",
  activePath = ""
} = Astro.props;
---

<!DOCTYPE html>
<html lang="th" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.net/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-full flex flex-col antialiased">
    <Navbar activePath={activePath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
